{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready|started|compiled"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "serverReadyAction": {
        "pattern": "Ready|started",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    },
    {
      "label": "Start API",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "rodando perfeitamente|ERRO"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start All",
      "dependsOn": [
        "Start API",
        "Start Web"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
